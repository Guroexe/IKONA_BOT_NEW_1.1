# Скопируйте в файл `.env` рядом с main.py и заполните значения.
# В публичный репозиторий `.env` не коммитьте.

TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

GOOGLE_SHEET_ID=
# Либо положите credentials.json рядом с main.py, либо (Railway) задайте JSON целиком:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

POLZA_IKONA_CHAT_API_KEY=
# Опционально:
# POLZA_IKONA_CHAT_MODEL=openai/gpt-5.3-chat
# OPENROUTER_API_KEY=
# CASINO_CREATOR_TELEGRAM_IDS=123456789,987654321
